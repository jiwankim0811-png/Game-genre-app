# ==========================================
# GenreCompass Environment Variables Template
# ==========================================

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Allowed Emails (Comma separated whitelist)
ADMIN_ALLOWED_EMAILS=admin@genrecompass.com,your_email@example.com

# Supabase Configuration (Optional - falls back to local in-memory dataset if unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
